---
import { env } from 'cloudflare:workers';
import Gallery from '../components/Gallery.astro';
import UploadForm from '../components/UploadForm.astro';
import Base from '../layouts/Base.astro';
import { getMaxUploadBytes } from '../lib/validation';

const maxBytes = getMaxUploadBytes(env.MAX_UPLOAD_MB);
---

<Base title="Galería">
  <section class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl preservar-espacio">
      Galería de <span class="bg-linear-to-r from-glow to-accent bg-clip-text text-transparent">imágenes</span>
    </h1>
    <p class="mt-3 text-base text-muted sm:text-lg ">
      Sube tus fotos y míralas en una cuadrícula ordenada. Cada imagen se guarda en tu propio equipo
      junto con una miniatura ligera; ábrela a pantalla completa, recórrelas con el teclado o
      elimínala cuando ya no la necesites.
    </p>
  </section>
  <div class="mt-8">
    <UploadForm maxBytes={maxBytes} />
  </div>
  <div class="mt-10">
    <Gallery />
  </div>
</Base>
