---
import { IMAGE_MIME_TYPES } from '../lib/storage';
import { THUMB_MAX_WIDTH } from '../lib/validation';

interface Props {
  maxBytes: number;
}

const { maxBytes } = Astro.props;
---

<form
  id="upload-form"
  data-max-bytes={maxBytes}
  data-thumb-width={THUMB_MAX_WIDTH}
  class="rounded-2xl border border-dashed border-line bg-surface p-5 transition-colors hover:border-accent/60 sm:p-6"
  novalidate
>
  <label for="upload-file" class="block font-medium">
    Subir imagen
  </label>
  <p class="text-sm text-muted">JPG, PNG, WebP o GIF. Máximo {maxBytes / 1024 / 1024} MB.</p>
  <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
    <input
      id="upload-file"
      name="file"
      type="file"
      accept={IMAGE_MIME_TYPES.join(',')}
      required
      class="min-w-0 flex-1 text-sm file:mr-3 file:rounded-full file:border-0 file:text-ink file:bg-subtle file:px-3 file:py-2 file:font-medium hover:file:bg-line"
    />
    <button
      type="submit"
      class="rounded-full bg-accent px-5 py-2 text-sm font-medium text-on-accent hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-50"
    >
      Subir
    </button>
  </div>
  <progress
    data-progress
    hidden
    max="100"
    value="0"
    class="mt-3 h-2 w-full accent-accent"
  ></progress>
  <p
    data-status
    role="status"
    aria-live="polite"
    class="mt-2 min-h-5 text-sm text-muted data-[state=error]:text-danger data-[state=success]:text-success"
  ></p>
</form>

<script>
  import type { ImageResponse } from '../lib/storage';

  // Miniatura WebP de máx. `maxWidth` px de ancho; devuelve también las dimensiones del original
  async function createThumbnail(file: File, maxWidth: number) {
    const bitmap = await createImageBitmap(file);
    const { width, height } = bitmap;
    const scale = Math.min(1, maxWidth / width);
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(width * scale));
    canvas.height = Math.max(1, Math.round(height * scale));
    canvas.getContext('2d')?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();

    const thumb = await new Promise<Blob | null>((resolve) =>
      canvas.toBlob(resolve, 'image/webp', 0.8),
    );
    // Algunos navegadores devuelven PNG si no soportan WebP
    if (!thumb || thumb.type !== 'image/webp') {
      throw new Error('Tu navegador no puede generar miniaturas WebP');
    }
    return { thumb, width, height };
  }

  // XMLHttpRequest permite medir el progreso de subida (fetch no)
  function send(data: FormData, onProgress: (percent: number) => void) {
    return new Promise<ImageResponse>((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/api/images');
      xhr.responseType = 'json';
      xhr.upload.onprogress = (event) => {
        if (event.lengthComputable) onProgress(Math.round((event.loaded / event.total) * 100));
      };
      xhr.onload = () => {
        if (xhr.status === 201) resolve(xhr.response);
        else reject(new Error(xhr.response?.error ?? `Error del servidor (${xhr.status})`));
      };
      xhr.onerror = () => reject(new Error('Error de red al subir la imagen'));
      xhr.send(data);
    });
  }

  const form = document.querySelector<HTMLFormElement>('#upload-form');

  if (form) {
    const input = form.querySelector<HTMLInputElement>('input[type=file]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const progress = form.querySelector<HTMLProgressElement>('[data-progress]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const maxBytes = Number(form.dataset.maxBytes);
    const thumbWidth = Number(form.dataset.thumbWidth);
    const allowedTypes = input.accept.split(',');

    const setStatus = (message: string, state: 'info' | 'error' | 'success' = 'info') => {
      status.textContent = message;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const file = input.files?.[0];

      if (!file) return setStatus('Selecciona una imagen', 'error');
      if (!allowedTypes.includes(file.type)) {
        return setStatus('Tipo no permitido: usa JPG, PNG, WebP o GIF', 'error');
      }
      if (file.size > maxBytes) {
        return setStatus(`La imagen supera ${maxBytes / 1024 / 1024} MB`, 'error');
      }

      button.disabled = true;
      input.disabled = true;
      try {
        setStatus('Generando miniatura…');
        const { thumb, width, height } = await createThumbnail(file, thumbWidth);

        const data = new FormData();
        data.append('file', file);
        data.append('thumb', thumb, 'thumb.webp');
        data.append('width', String(width));
        data.append('height', String(height));

        progress.value = 0;
        progress.hidden = false;
        setStatus('Subiendo… 0 %');
        const image = await send(data, (percent) => {
          progress.value = percent;
          setStatus(`Subiendo… ${percent} %`);
        });

        form.reset();
        setStatus('Imagen subida', 'success');
        document.dispatchEvent(new CustomEvent('image:uploaded', { detail: image }));
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'No se pudo subir la imagen', 'error');
      } finally {
        progress.hidden = true;
        button.disabled = false;
        input.disabled = false;
      }
    });
  }
</script>
