---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Galería personal para subir, guardar y ver tus imágenes en tu propio equipo.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f5fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d1c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Mi galería</title>
    <!-- Antes de pintar: tema guardado o el del sistema, para evitar parpadeo -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Sin almacenamiento se usa el tema del sistema
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas text-ink antialiased">
    <header class="sticky top-0 z-10 border-b border-line bg-canvas/80 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span
            aria-hidden="true"
            class="size-3 rounded-full bg-linear-to-br from-glow to-accent shadow-[0_0_12px] shadow-accent/60"
          ></span>
          Mi galería
        </a>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar a modo oscuro"
          class="rounded-full border border-line p-2 text-muted transition-colors hover:bg-subtle hover:text-ink"
        >
          <!-- Luna en modo claro, sol en modo oscuro -->
          <svg
            class="size-4 dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg
            class="hidden size-4 dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>
    <footer class="border-t border-line py-6 text-center text-sm text-muted">
      © {new Date().getFullYear()} SimCorp
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const root = document.documentElement;

      const updateLabel = () => {
        const next = root.dataset.theme === 'dark' ? 'claro' : 'oscuro';
        toggle?.setAttribute('aria-label', `Cambiar a modo ${next}`);
      };

      toggle?.addEventListener('click', () => {
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch {
          // Sin almacenamiento el tema dura solo esta visita
        }
        updateLabel();
      });

      updateLabel();
    </script>
  </body>
</html>
